{
  "_om": "Testsæt for smart søgning. 'expect': felter der SKAL have præcis disse værdier (lister sammenlignes uden rækkefølge). 'absent': felter der IKKE må være sat. 'keywords': ord der skal være blandt sorteringsordene. Er en rigtig søgning gået galt (se smart_search_logs), så læg den ind her med det rigtige svar, før instruktionen rettes.",
  "cases": [
    { "text": "citybike med kurv", "expect": { "types": ["Citybike"] }, "absent": ["search", "stepTypes"], "keywords": ["kurv"] },
    { "text": "damecykel med kurv", "expect": { "stepTypes": ["Lav indstigning"] }, "absent": ["search", "types"], "keywords": ["kurv"] },
    { "text": "herrecykel 7 gear", "expect": { "stepTypes": ["Høj indstigning"] }, "absent": ["search"] },
    { "text": "bycykel med bagagebærer og lys", "expect": { "types": ["Citybike"] }, "absent": ["search"], "keywords": ["bagagebærer"] },
    { "text": "elcykel til pendling under 10.000", "expect": { "types": ["El-cykel"], "maxPrice": 10000 }, "absent": ["search"] },
    { "text": "e-bike med Bosch midtermotor", "expect": { "types": ["El-cykel"], "motors": ["Bosch"], "motorPositions": ["Midtermotor"] }, "absent": ["search"] },
    { "text": "cykel til en 6-årig", "expect": { "types": ["Børnecykel"] }, "absent": ["search"] },
    { "text": "pigecykel 20 tommer", "expect": { "types": ["Børnecykel"], "wheelSizes": ["20\""] }, "absent": ["search"] },
    { "text": "racer str. 56", "expect": { "types": ["Racercykel"], "sizes": ["L (56–58 cm)"] }, "absent": ["search"] },
    { "text": "herrecykel str 60 cm", "expect": { "sizes": ["XL (59+ cm)"] }, "absent": ["search"] },
    { "text": "carbon gravel i str. M under 15.000 kr.", "expect": { "types": ["Gravel"], "frameMaterials": ["Carbon"], "sizes": ["M (52–55 cm)"], "maxPrice": 15000 }, "absent": ["search"] },
    { "text": "landevejscykel med Ultegra Di2", "expect": { "types": ["Racercykel"], "groupsets": ["Shimano Ultegra"], "electronicShifting": true }, "absent": ["search"] },
    { "text": "Specialized Tarmac", "expect": { "brands": ["Specialized"], "search": "Tarmac" } },
    { "text": "Trek Domane str 54", "expect": { "brands": ["Trek"], "search": "Domane" } },
    { "text": "MTB fully 29\"", "expect": { "types": ["Mountainbike"], "suspensions": ["Fuld affjedring (fully)"], "wheelSizes": ["29\""] }, "absent": ["search"] },
    { "text": "hardtail mountainbike til begynder", "expect": { "types": ["Mountainbike"], "suspensions": ["Forgaffel (hardtail)"] }, "absent": ["search"] },
    { "text": "ladcykel til to børn", "expect": { "types": ["Ladcykel"] }, "absent": ["search"] },
    { "text": "christianiacykel", "expect": { "types": ["Ladcykel"] }, "absent": ["search"] },
    { "text": "Babboe ladcykel med el", "expect": { "brands": ["Babboe"] }, "absent": ["search"] },
    { "text": "brugt cykel i Aarhus", "expect": { "city": "Aarhus" }, "absent": ["search", "conditions"] },
    { "text": "billig cykel i København", "absent": ["search", "maxPrice", "minPrice"] },
    { "text": "ny elcykel fra en forhandler", "expect": { "types": ["El-cykel"], "conditions": ["Ny"], "sellerType": "dealer" }, "absent": ["search"] },
    { "text": "cykel med navgear og fodbremse", "expect": { "geartypes": ["Indvendig"], "brakeTypes": ["Rullebremser"] }, "absent": ["search"] },
    { "text": "sort damecykel med skærme", "expect": { "colors": ["Sort"], "stepTypes": ["Lav indstigning"] }, "absent": ["search"], "keywords": ["skærm"] },
    { "text": "cykel til en der er 185 cm høj", "expect": { "sizes": ["XL (59+ cm)"] }, "absent": ["search"] },
    { "text": "cykel til en på 165 cm", "expect": { "sizes": ["S (48–51 cm)"] }, "absent": ["search"] },
    { "text": "omkring 10.000 kr", "expect": { "minPrice": 8000, "maxPrice": 12000 }, "absent": ["search"] },
    { "text": "Gazelle damecykel", "expect": { "brands": ["Gazelle"], "stepTypes": ["Lav indstigning"] }, "absent": ["search"] },
    { "text": "cykel med barnestol", "absent": ["search"], "keywords": ["barnestol"] },
    { "text": "senior cykel med lav indstigning", "expect": { "types": ["Senior cykel"], "stepTypes": ["Lav indstigning"] }, "absent": ["search"] },
    { "text": "lightweight road bike under 8 kg", "expect": { "types": ["Racercykel"], "maxWeight": 8 }, "absent": ["search"] }
  ]
}
